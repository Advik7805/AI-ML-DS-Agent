# Saros — every environment variable the platform understands.
#
# NOTHING HERE IS REQUIRED. The whole product runs with an empty environment: every body trains
# on a real-or-generated dataset, every external service falls back to a deterministic mock that
# labels itself, and the agent runs on the mock provider. Copy this to `.env`, fill in what you
# have, and the corresponding features light up.
#
# Two rules baked into the code:
#   1. A key alone does not enable live calls for the paid/metered services. They also need the
#      matching `*_LIVE=1` flag, so a key left in a local .env cannot make a demo billable.
#   2. Nothing is silently faked. A mock announces itself in the API payload (backend: "mock")
#      and in the UI, because an agent that cannot tell simulated retrieval from real retrieval
#      will confidently cite things that never happened.
#
# Check what is live at any time:  GET /api/v1/integrations


# --- LLM providers for the hub agent ------------------------------------------
# Unset (or a missing key) => the deterministic mock provider, which calls the real tools and
# templates its answers from the real numbers. Good enough to demo the whole product.
SAROS_LLM=auto                      # auto | mock | groq | gemini | echo (auto needs no key)
GROQ_API_KEY=
GEMINI_API_KEY=


# --- Tavily: web search + JS-rendering page extraction ------------------------
# Free: 1,000 credits/month, no credit card, students free. Basic search = 1 credit,
# extraction = 1 credit per 5 URLs, so the free allowance covers real development.
# Keys start with "tvly-". Docs: https://docs.tavily.com
TAVILY_API_KEY=
SAROS_TAVILY_LIVE=0                 # 1 to actually call Tavily
SAROS_TAVILY_MAX_RESULTS=5          # up to 20; more results is not more credits
SAROS_TAVILY_SEARCH_DEPTH=basic     # basic (1 credit) | advanced (2 credits)


# --- Firecrawl: production scraping -------------------------------------------
# Declared in the integration catalogue so the key can be set at deploy time; the client is not
# wired into the scraper body yet. Tavily's extract endpoint covers the same ground on the free
# tier, which is why it shipped first. Free: 500 credits one-time.
# Jina Reader - JS-rendering scrape, and the DEFAULT backend for render_url.
# The key is OPTIONAL: the anonymous endpoint works with no key at ~20 req/min. A free key
# (10M tokens, no card) raises that to 500 RPM. This is why rendering works on a fresh
# deploy with zero configuration, unlike Firecrawl's one-time 500 credits.
JINA_API_KEY=

FIRECRAWL_API_KEY=
SAROS_FIRECRAWL_LIVE=0


# --- Plain-HTTP scraping (the scraper body's own fetcher) ---------------------
# Deliberately separate from Tavily. A plain GET is free but cannot render JavaScript.
SAROS_SCRAPER_LIVE=0                # 1 to fetch over HTTP instead of returning mock content
SAROS_SCRAPER_ALLOW=                # comma-separated hosts, e.g. example.com,docs.example.com
                                    # Empty => every live fetch is blocked. This exists so the
                                    # agent cannot be pointed at an arbitrary site.


# --- Supabase: pgvector for RAG embeddings ------------------------------------
# Free: 500 MB Postgres, 2 projects, pauses after a week of inactivity. Only worth wiring once
# the corpus outgrows in-memory TF-IDF; at 25 passages it is a round trip for nothing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SAROS_SUPABASE_LIVE=0
# Table the extra documents live in. Created with the schema in core/integrations/supabase.py.
SAROS_SUPABASE_TABLE=knowledge_documents


# --- Upstash Redis: rate limiting and caching ---------------------------------
# Free: 10,000 commands/day, 256 MB. Worth adding before anything public, so one crawler cannot
# exhaust a free-tier backend's request budget.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SAROS_UPSTASH_LIVE=0


# --- experiment tracking -------------------------------------------------------
# Training is hooked at the contract level, so every body records its run automatically.
# Set MLFLOW_TRACKING_URI to send runs to an MLflow server; leave it unset and they append to
# the local JSONL file below. Tracking is on either way, and GET /api/v1/runs says which
# backend answered. mlflow is NOT in requirements.txt (see requirements-mlflow.txt) - it is
# ~100 MB and the API runs on a 512 MB container.
#MLFLOW_TRACKING_URI=
# Where the local run log lives. Render's filesystem is ephemeral, so this is lost on redeploy.
#SAROS_RUNS_FILE=artifacts/runs.jsonl

# --- which model each LLM provider calls ---------------------------------------
# Both fall back to a sensible current model when unset. Override to pin a version or try a
# newer release without a code change.
#GROQ_MODEL=
#GEMINI_MODEL=

# --- rate limiting -------------------------------------------------------------
# Requests per client per path within the window. In-memory by default, which means per-process
# and reset on restart - fine for a demo, and the X-RateLimit-Backend header says so. Configure
# Upstash above for a limit shared across instances.
#SAROS_RATE_LIMIT=60
#SAROS_RATE_WINDOW=60

# --- API gateway ---------------------------------------------------------------
# CORS is ["*"] in apps/api/main.py; the frontend proxies through Next rewrites in dev, so the
# browser only ever talks to its own origin.
API_ORIGIN=http://127.0.0.1:8000
# Optional. Host-based routing: if set, requests for this host render the churn storefront at
# the domain root, so one deploy can serve churn.example.com as its own site. Handled by the
# rewrites in apps/web/next.config.ts.
#CHURN_HOST=
# Origins allowed to load Next's *dev* resources (HMR socket, dev chunks) — comma separated.
# Only matters for `next dev`, and only when the dev server is reached through a host it does not
# recognise: a preview URL, a LAN IP, a container hostname. Next 16 blocks those by default, and
# because the dev client waits on the HMR socket before hydrating, a blocked request means the
# page renders and *nothing works* — no error, no clue. localhost, 127.0.0.1, 0.0.0.0 and
# *.e2b.app / *.vercel.app wildcards are already in next.config.ts; add anything else here.
#SAROS_DEV_ORIGINS=192.168.1.50,my-preview.host.ts.net

# --- optional storefront backdrop video -------------------------------------
# Unset by default, and it should stay that way unless you have a CDN. A background video is
# 5-30 MB; committing one means every clone and every deploy carries it. Point this at a
# hosted file instead - Cloudflare R2's free tier is 10 GB storage and 10 GB egress.
# Only http(s) URLs are accepted; anything else is ignored and the 3D field renders alone.
# Read server-side, so it never enters the client bundle and needs no NEXT_PUBLIC_ prefix.
#BACKDROP_VIDEO_URL=    # where the Next.js server reaches FastAPI
